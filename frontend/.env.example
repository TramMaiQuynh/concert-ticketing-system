# URL gốc của backend API. Vite chỉ đưa vào bundle các biến có tiền tố VITE_.
# Mặc định khi không đặt: http://localhost:5295/api (khớp launchSettings.json của backend).
#
# LƯU Ý: chỉ đặt ở đây những giá trị KHÔNG bí mật — mọi biến VITE_ đều nằm trong
# bundle và ai xem mã nguồn trang cũng đọc được. Bí mật (JWT secret, chữ ký thanh toán)
# thuộc về backend, không bao giờ đưa xuống frontend.
VITE_API_BASE_URL=http://localhost:5295/api
