{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "localhost;127.0.0.1",
  "ConnectionStrings": {
    "Default": ""
  },
  "Jwt": {
    "Secret": "",
    "Issuer": "ConcertTicketingAPI",
    "Audience": "ConcertTicketingClients",
    "AccessTokenExpiryMinutes": 30,
    "RefreshTokenExpiryDays": 7
  },
  "PaymentSignature": {
    "Secret": ""
  },
  "Redis": {
    "ConnectionString": "localhost:6379",
    "SeatMapTtlSeconds": 15
  },
  "Hangfire": {
    "DashboardPath": "/hangfire"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/concert-api-.log",
          "rollingInterval": "Day"
        }
      }
    ]
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "http://127.0.0.1:5173"
    ]
  },
  "PaymentGateway": {
    "Mode": "Simulator",
    "SimulatorReturnUrl": "http://localhost:5173/payment-simulator",
    "ExternalPaymentUrl": "https://sandbox.vnpayment.vn/paymentv2/vpcpay.html"
  }
}
